# Unix
#PTHREAD=	# for Mac
PTHREAD=-pthread -DPTHREAD
AR=ar
AS=no-as-here
RANLIB=ranlib
X11=/usr/X11R6
CC=cc -w -std=c89
CFLAGS= -w -ggdb -I$(ROOT) -I$(ROOT)/include -I$(ROOT)/kern -c -I$(X11)/include -D_THREAD_SAFE $(PTHREAD) -O2 -Wno-implicit-function-declaration
O=o
OS=posix
GUI=x11
LDADD=-L$(X11)/lib64 -L$(X11)/lib -lX11 -ggdb
LDFLAGS=$(PTHREAD)
TARG=drawterm
AUDIO=none
# AUDIO=unix

all: default

libmachdep.a:
	(cd posix-port &&  make)
